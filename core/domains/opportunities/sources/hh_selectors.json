      "salary": "[data-qa=\"compensation\"]",
      "address": "[data-qa=\"vacancy-serp__vacancy-address\"]",
      "metro": "[data-qa=\"vacancy-serp__vacancy-metro\"]",
      "respondBtn": "[data-qa=\"vacancy-serp__vacancy_response\"]",
      "pagerNext": "[data-qa=\"pager-next\"]"
