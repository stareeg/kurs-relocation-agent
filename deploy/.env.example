# =============================================================================
# Career Copilot — образец настроек
# =============================================================================
# 1. Скопируйте этот файл в .env в корне репозитория
# 2. Заполните блок «Настройте сами» ниже
# 3. Поднимите Postgres (см. README) и выполните:  python -m core.platform.db.migrate
#
# Секреты не коммитьте. Папки resume/, secrets/, logs/ — локальные.
# =============================================================================


# =============================================================================
# НАСТРОЙТЕ САМИ (минимум для работы)
# =============================================================================

# --- OpenRouter (LLM: скоринг, чаты, подготовка к собесам) ---
# Что нужно: API-ключ вида sk-or-v1-...
# Как получить:
#   1. Зайдите на https://openrouter.ai и войдите в аккаунт
#   2. Settings → Keys → Create Key
#   3. Скопируйте ключ сюда (без кавычек)
OPENROUTER_API_KEY=

# --- PostgreSQL (воронка, чаты, история) ---
# Что нужно: работающая база copilot на localhost:5432
# Как получить (один раз):
#   1. Установите PostgreSQL 18 (или используйте deploy/compose.yaml)
#   2. psql -h 127.0.0.1 -p 5432 -U postgres -f deploy\init_native_pg.sql
#   3. python -m core.platform.db.migrate
# Логин/пароль ниже должны совпадать с тем, что создал init_native_pg.sql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
POSTGRES_SSLMODE=disable

# --- Вход в веб-интерфейс ---
# Логина и пароля нет: вход — по токену из Telegram-бота (кнопка «Токен авторизации»).
# Пока токен ни разу не выпущен, веб открыт локально: онбординг в «Параметрах» доступен сразу.

# --- Ключ для расширения Chrome (запасной путь) ---
# В поле X-API-Key расширения можно вставить токен авторизации из бота (основной путь).
# API_KEY — необязательная статическая альтернатива для скриптов/отладки:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Резюме (источник для скоринга) ---
# Что нужно: JSON с вашим резюме (редактируется во вкладке «Резюме»)
# Как получить: скопируйте пустой шаблон deploy/resume_data.example.json
#   → resume/resume_data.json (поля пустые; подсказки - placeholder'ы в форме).
#   Папка resume/ в git не попадает — это ваши данные.
RESUME_DATA_PATH=resume/resume_data.json

# --- Адреса (обычно менять не нужно) ---
BACKEND_URL=http://localhost:8000
WEB_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- Прод/ВМ — НЕ для friend-install ---
# На хостинге за Caddy (deploy/compose.prod.yaml) три адреса выше становятся одним доменом:
#   BACKEND_URL=https://<домен>  WEB_URL=https://<домен>  FRONTEND_ORIGIN=https://<домен>
# DOMAIN — подставляется в deploy/Caddyfile ({$DOMAIN}) для автосертификата Let's Encrypt.
# WEB_COOKIE_SECURE=true — Secure-флаг на куке copilot_auth (api/config.py); на localhost/http
# оставить false, иначе браузер куку не примет.
# DOMAIN=
# WEB_COOKIE_SECURE=false


# =============================================================================
# ПО ЖЕЛАНИЮ (можно оставить пустым)
# =============================================================================

# --- Telegram-бот: уведомления, кнопки, пересылки от HR ---
# Токен официального бота продукта. Заполняется ТОЛЬКО на инстансе, который запускает бота
# (у владельца); в обычной установке оставить пустым — токен входа выдаёт центральный бот
# (t.me/…, кнопка «Токен авторизации»), свой бот создавать не нужно.
TELEGRAM_BOT_TOKEN=
# Username официального бота без @ — ссылка t.me/… в веб-интерфейсе
TELEGRAM_BOT_USERNAME=BBX_fan_bot
# Ваш numeric user id (узнать у @userinfobot) — бот отвечает только вам
ADMIN_USER_ID=
# Username в Telegram без @ — запасной способ узнать вас
ADMIN_USERNAMES=
# TELEGRAM_PROXY=socks5://127.0.0.1:1080   # если api.telegram.org не открывается
TELEGRAM_PROXY=
# На рос. хостинге (Selectel и т.п.) api.telegram.org может быть недоступен на уровне TCP
# (РКН режет пакеты к IP Telegram, ICMP при этом жив — не путать с обычной сетевой нестабильностью
# из TELEGRAM_PROXY выше). Тогда нужен не SOCKS-прокси (он тоже сидит на этой же залоченной сети),
# а замена самого хоста Bot API на прокси-воркер вне блокировки — см. deploy/cloudflare/README.md
# и bot_app/session.py (TelegramAPIServer.from_base). Пример после деплоя воркера:
# TELEGRAM_API_BASE=https://<имя-воркера>.<аккаунт>.workers.dev
TELEGRAM_API_BASE=
TELEGRAM_REQUEST_TIMEOUT=120
BOT_PRIVATE_ONLY=true
GETMATCH_BOT_USERNAMES=g_jobbot

# --- OpenRouter: прокси (если провайдер блокирует OpenRouter) ---
# На рос. хостинге OpenRouter может отвечать 403 "Access denied by security policy" на запросы
# с IP хостинга (не проблема ключа/баланса — подтверждено тем же ключом с другой машины,
# docs/problems.md, 2026-08-05) — тогда см. OPENROUTER_BASE_URL ниже. НЕ Cloudflare Workers:
# они исполняются в датацентре, ближайшем к вызывающей стороне (с этой ВМ — Хельсинки), а именно
# его блокирует само OpenRouter'овское Bot Management — нужен сервис с фиксированным регионом,
# см. deploy/render_relay/README.md:
# OPENROUTER_PROXY=socks5://127.0.0.1:1080


# =============================================================================
# РАСШИРЕННЫЕ НАСТРОЙКИ (дефолты обычно подходят; править при необходимости)
# =============================================================================

# --- OpenRouter: модели и fallback ---
# На хостинге, заблокированном для OpenRouter напрямую (см. комментарий выше), заменить хост на
# фиксированно-региональный релей: OPENROUTER_BASE_URL=https://<релей>.onrender.com/api/v1
# (суффикс /api/v1 остаётся тем же) — deploy/render_relay/README.md.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FALLBACK=google/gemini-3.7-flash

# --- Тиры моделей (3-тирная схема, имена slug на OpenRouter) ---
# advanced — рассуждение (judge/planner/ask, prep/situation) → Gemini 3.7 Flash.
# basic — вычленение/structured (скоринг, парсинг, короткие чаты).
# reserve — фичи раздела «Резюме» (усиление/критик/навыки/парсинг/role-fit) + глобальный
# fallback ниже. reasoning_effort Gemini 3.x принимает (OpenRouter мапит его в thinkingLevel:
# low/medium/high, дефолт medium) — на advanced-фичах effort остаётся "medium".
MODEL_TIER_ADVANCED=google/gemini-3.7-flash
MODEL_TIER_BASIC=openai/gpt-5.6-luna
MODEL_TIER_RESERVE=google/gemini-3.7-flash
# Тир-осознанный fallback: для advanced откат на basic ПЕРЕД глобальным reserve-фолбэком выше.
# advanced и reserve теперь оба = gemini-3.7-flash, поэтому этот откат — единственный не-Gemini
# запасной в цепочке advanced (gemini → gpt-luna), а не бессмысленный повтор той же модели.
MODEL_TIER_FALLBACK={"advanced": "openai/gpt-5.6-luna"}
# OpenRouter provider routing (docs: «Provider Routing») → поле `provider` каждого запроса,
# если непусто. {"sort": "throughput"} обходит перегруженный провайдер модели, {"order": [..]}
# фиксирует список. Пусто = решает OpenRouter. Осознанный аварийный тумблер, не дефолт.
OPENROUTER_PROVIDER={}
# Мультиплеер: модели игр раздела. Вызовы идут с model_override, не через MODEL_TIER_*.
# Это единственное место, где выбираются модели: меняются одной строкой, перезапуск api — и
# всё. В Python slug не хардкожен нигде (`core/domains/multiplayer/llm.py` знает только роли).
# Reasoning для этих фич выключен в декларациях (`reasoning_effort="none"` → платформа шлёт
# `reasoning.enabled=false`), поэтому подставлять можно и «мыслящую по умолчанию» модель.
#
# Критерий выбора здесь не тот же, что у рабочих тиров: нужен не разбор, а живой короткий
# текст с чувством юмора. DeepSeek V4 Flash пробовали — читается как ai slop, шутку игры не
# понимает (владелец, 2026-08-27).
#
# РЕЖИССЁР — мир вокруг стола: сцена слота, газета. Нужна подноготная российского IT.
# Пусто = игровые фичи молча отдают статические заглушки (так прод и прожил до Э18 —
# снаружи неотличимо от «модель отвечает скучно»).
# Был `qwen/qwen3.8-flash` — прод-журнал 2026-08-28: почти каждый вызов ловит upstream 429
# и/или уходит в 17–30 с на одну фразу, режиссёрские фичи стабильно садились на заглушку.
# `gpt-5.6-luna` (та же модель, что тянет рабочий тир basic) отвечает за 1–3 с и не
# rate-limited. Если вернёте qwen — держите наготове OPENROUTER_PROVIDER={"sort":"throughput"}.
MODEL_MULTIPLAYER=openai/gpt-5.6-luna
# АКТЁР — прямая речь персонажей: реплики кандидатов, реакции на штамп. Нужна пластичность
# отыгрыша (шесть амплуа обязаны звучать по-разному) и низкий TTFT: эти вызовы стоят внутри
# фазы, и их стримят прямо за стол. Пусто = эту роль играет режиссёр.
# Замер 2026-08-27: hy3 отвечает за 1.5–3 с, qwen на том же промпте ловил upstream 429 и
# уходил в 15–30 с — разделение заодно разводит нагрузку по разным провайдерам.
MODEL_MULTIPLAYER_ACTOR=tencent/hy3
# АРБИТР — суд: единственная фича раздела со structured-выходом (`WolvesJudgeOut`), где поле
# `cited_marker` сверяется с поданным иском. Здесь нужен не характер, а предсказуемый JSON,
# поэтому берём ту же модель, что тянет structured в рабочих тирах. Пусто = режиссёр.
MODEL_MULTIPLAYER_ARBITER=google/gemini-3.7-flash
# Узкие ручные переопределения тира поверх LlmFeature в domains/*/llm.py (A-06). Пусто в норме.
# Полный перечень фич — в коде; покрытие — tests/test_llm_feature_registry.py.
AGENT_TIER_OVERRIDES={}
# Легаси: effort по тиру только для фабрики модели по сырому тиру (без фичи).
# Продуктовый путь — LlmFeature.reasoning_effort в domains/*/llm.py (L-14). Пусто = выкл.
MODEL_TIER_EFFORT={}

# --- Защита от аварийно гигантского одиночного запроса (символов на вызов; 0 = выкл) ---
# Не дневной cost-лимит (их убрали — лимит трат настраивается на стороне OpenRouter), а страховка
# от явно сломанного огромного входа. В обычной работе не срабатывает.
LLM_MAX_INPUT_CHARS=800000

# --- Вложения-картинки в чатах (загрузка/GC) ---
# Через сколько часов удалять несвязанные вложения (загрузил в композер и передумал отправлять).
ATTACHMENT_GC_AFTER_HOURS=24

# --- Скоринг ---
# Промпты — в prompts/<domain>/, пути в core.domains.*.llm (R-40), не в .env.
SCORING_SALARY_USE_LLM=true
# Опциональный сид рыночных бенчмарков вилок (копия deploy/salary_benchmarks.example.json).
# Пусто — не загружать: ориентир от резюме кандидата, не таблица под senior IT.
SALARY_BENCHMARKS_PATH=

# --- Калибровка зарплат в боте (/calib) ---
# Авто-разбор очереди выключен по умолчанию: настройка теперь вручную через фронтенд.
SALARY_CALIB_AUTO=false
SALARY_CALIB_DEBOUNCE_SEC=25
SALARY_CALIB_MIN_PENDING=1
SALARY_CALIB_ANALYZE_EVERY=12
SALARY_CALIB_EXPORT_PATH=logs/salary_calibration_latest.md

# --- Прочие LLM ---
# Фичи усиления резюме живут на reserve-тире (см. domains/profile/llm.py).
RESUME_STRENGTHEN_TOP_VACANCIES=5
RESUME_ATS_FIT_TOP_VACANCIES=5

# --- Прайс для учёта стоимости (USD за 1M токенов) ---
MODEL_PRICES={"openai/gpt-5.6-luna": {"input": 1.0, "output": 6.0}, "google/gemini-3.7-flash": {"input": 0.75, "output": 3.75}}
DEFAULT_PRICE_INPUT_PER_1M=0.5
DEFAULT_PRICE_OUTPUT_PER_1M=1.5

# --- LangSmith (трассировка LLM; опционально) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_API_KEY_PATH=secrets/langsmith-api-key.md
LANGSMITH_PROJECT=copilot
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Логи ---
LOG_LEVEL=INFO
LOG_LEVEL_FILE=DEBUG
LOG_DIR=logs
LOG_RICH=true
LOG_ROTATION_MB=5
LOG_BACKUPS=5

# --- Официальный api.hh.ru (ссылка в Telegram-бота). Не подделывать Chrome.
# Пусто — CareerCopilot/<версия расширения>, без URL сайта.
# HH_API_USER_AGENT=CareerCopilot/1.0

# --- Docker Postgres (только если поднимаете БД через deploy/compose.yaml) ---
# POSTGRES_HOST_PORT=5433
